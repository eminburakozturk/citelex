{
  "$schema": "https://schema.tauri.app/config/2/schema.json",
  "productName": "Citelex",
  "version": "0.1.0",
  "identifier": "com.citelex.client",
  "build": {
    "beforeBuildCommand": "node build-web.mjs",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Citelex",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
